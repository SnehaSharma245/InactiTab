{
  "manifest_version": 3,
  "name": "InactiTab Manager",
  "version": "1.0",
  "description": "Manage inactive tabs with smart whitelist and customizable settings",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon2.png",
      "32": "icons/icon2.png",
      "48": "icons/icon2.png",
      "128": "icons/icon2.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon2.png",
    "32": "icons/icon2.png",
    "48": "icons/icon2.png",
    "128": "icons/icon2.png"
  }
}
